10 ' 矢印キーで @ を動かす。ESC で終了
20 CLS 3:X=40:Y=12
30 LOCATE 0,0:PRINT "矢印キーで動く / ESC で終了"
40 LOCATE X,Y:PRINT "@";
50 K$=INKEY$:IF K$="" THEN 50
60 LOCATE X,Y:PRINT " ";
70 IF K$=CHR$(&H1C) AND X<79 THEN X=X+1
80 IF K$=CHR$(&H1D) AND X>0 THEN X=X-1
90 IF K$=CHR$(&H1E) AND Y>1 THEN Y=Y-1
100 IF K$=CHR$(&H1F) AND Y<24 THEN Y=Y+1
110 GOTO 40
